font-family = "Fira Code Regular"
font-size = 20
background-image-opacity = 0.8

selection-word-chars = true

maximize = true

quit-after-last-window-closed = true

# Reuse one Zellij session for all Ghostty windows and tabs.
command = direct:/usr/bin/env -u NO_COLOR /opt/homebrew/bin/zellij attach --create main
