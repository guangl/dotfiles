# Keep interactive Ghostty shells colored, including reused Zellij sessions.
if [[ -o interactive && -t 1 && "${TERM_PROGRAM:-}" == ghostty ]]; then
  unset NO_COLOR
fi

# Custom completion definitions must be available before Zim initializes completion.
fpath=(${XDG_DATA_HOME:-$HOME/.local/share}/zsh/site-functions $fpath)

# ======== ZIM load ==================
# Zim - A Zsh Configuration Framework
ZIM_HOME=${ZDOTDIR:-${HOME}}/.zim
# Install missing modules and update ${ZIM_HOME}/init.zsh if missing or outdated.
if [[ ! ${ZIM_HOME}/init.zsh -nt ${ZIM_CONFIG_FILE:-${ZDOTDIR:-${HOME}}/.zimrc} ]]; then
  source /opt/homebrew/opt/zimfw/share/zimfw.zsh init
fi
# Initialize modules.
source ${ZIM_HOME}/init.zsh
# ====================================

# ====================================
# ======== Application Load ==========
#
#
# ======== starship ==================
eval "$(starship init zsh)"
# ====================================
#
# ======== Alias =====================
alias ls='eza --group-directories-first --icons'
# ====================================
#
# ======== Atuin =====================
eval "$(atuin init zsh)"
# ====================================
#
# ======== Zellji ====================
# Auto-start only in an interactive terminal, never during `zsh -c` probes.
# Reuse a fixed session so closing/reopening terminals cannot accumulate sessions.
if [[ -o interactive && -z "${ZSH_EXECUTION_STRING:-}" && -t 0 && -t 1 \
      && -z "${ZELLIJ:-}" && "${TERM:-dumb}" != dumb ]] \
      && (( $+commands[zellij] )); then
  zellij attach --create main
fi
# ====================================
#
# ======== Espanso ===================
export ESPANSO_CONFIG_DIR="$HOME/.config/espanso"
# ====================================
#
# ======== Starship ==================
export STARSHIP_CONFIG="$HOME/.config/starship/config.toml"
# ====================================
#
# ======== DNS Pick ==================
export PATH="/Users/luoguang/.local/bin:$PATH"
# ====================================
#
# ======== Bun =======================
export PATH="/Users/luoguang/.bun/bin:$PATH"
#
# ======== Cargo =====================
export PATH="/Users/luoguang/.cargo/bin:$PATH"
#
# ======== Application end ===========

# ======== Alias =====================
alias cd='z'
alias rm='trash'
alias ce='chezmoi edit --apply'
alias dotedit='nvim $(chezmoi source-path)'
alias reload='exec zsh'
# ====================================





