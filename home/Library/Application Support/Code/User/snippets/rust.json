{
	// Place your snippets for rust here. Each snippet is defined under a snippet name and has a prefix, body and
	// description. The prefix is what is used to trigger the snippet and the body will be expanded and inserted. Possible variables are:
	// $1, $2 for tab stops, $0 for the final cursor position, and ${1:label}, ${2:another} for placeholders. Placeholders with the
	// same ids are connected.
	// Example:
	// "Print to console": {
	// 	"prefix": "log",
	// 	"body": [
	// 		"console.log('$1');",
	// 		"$2"
	// 	],
	// 	"description": "Log output to console"
	// }
	"Main Function": {
		"prefix": "main",
		"body": [
			"fn main() {",
			"\t$0",
			"}",
		],
		"description": "The main function",
	},
	"read a file": {
		"prefix": "readfile",
		"body": [
			"fn get_config_content(path: &str) -> Result<$1> {",
			"\tlet mut file = File::open(path).expect(\"can not open file.\");",
			"\tlet mut content = String::new();",
			"\tfile.read_to_string(&mut content).expect_err(\"can not read file.\");",
			"\tlet config: $1 = toml::from_str(&content).expect(\"can not parser file.\");",
			"",
			"\tOk(config)",
			"}"
		],
		"description": "read a file"
	}
}
