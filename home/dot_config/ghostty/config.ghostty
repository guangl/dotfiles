theme = Catppuccin Mocha
font-family = FiraCode Nerd Font Mono
font-size = 17
adjust-cell-height = 8%

background-opacity = 0.94
background-blur = 24
cursor-color = #b4befe
selection-background = #45475a
selection-foreground = #cdd6f4
window-padding-x = 14
window-padding-y = 10
window-padding-balance = true
window-theme = dark

selection-word-chars = true

maximize = true

quit-after-last-window-closed = true

# Reuse one Zellij session for all Ghostty windows and tabs.
command = direct:/usr/bin/env -u NO_COLOR /opt/homebrew/bin/zellij attach --create main
