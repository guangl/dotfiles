{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/kitty-ghost.txt",
    "color": { "1": "#b4befe" },
    "padding": { "top": 1, "left": 1, "right": 4 }
  },
  "display": {
    "separator": "  ",
    "color": { "keys": "#b4befe", "separator": "#585b70" }
  },
  "modules": [
    { "type": "os", "key": "OS" },
    { "type": "kernel", "key": "├─ Kernel" },
    { "type": "packages", "key": "└─ Packages" },
    "break",
    { "type": "terminal", "key": "Terminal" },
    { "type": "shell", "key": "├─ Shell" },
    { "type": "terminalfont", "key": "└─ Font" },
    "break",
    { "type": "host", "key": "Mac" },
    { "type": "cpu", "key": "├─ CPU" },
    { "type": "gpu", "key": "├─ GPU" },
    { "type": "memory", "key": "├─ Memory" },
    { "type": "disk", "key": "└─ Disk", "folders": "/" },
    "break",
    { "type": "colors", "symbol": "block" }
  ]
}
